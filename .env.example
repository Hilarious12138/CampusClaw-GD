# Fourth lesson: server-only model configuration
EMBEDDING_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
EMBEDDING_API_KEY=replace-with-your-server-side-key
EMBEDDING_MODEL=course-embedding
EMBEDDING_DIM=2048

# Dialogue uses the same gateway/key as embeddings unless overridden.
CHAT_MODEL=course-chat
